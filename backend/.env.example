# Copie este arquivo para .env e ajuste os valores. Nunca versione o .env.

APP_NAME=Amazon Agrosciences - Gestão de Estoque
APP_VERSION=0.2.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# MongoDB local (Community Server) ou MongoDB Atlas:
# MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=amazon_agrosciences
MONGODB_TIMEOUT_MS=3000

# Origens do frontend autorizadas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
