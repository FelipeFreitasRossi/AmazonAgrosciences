# Copie este arquivo para .env. Variáveis VITE_* ficam visíveis no navegador:
# nunca coloque segredos aqui.

# Base da API usada pelo frontend (em dev, o proxy do Vite encaminha /api ao backend)
VITE_API_URL=/api/v1

# Endereço do backend para o proxy do Vite
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
